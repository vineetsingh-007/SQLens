# Exclude local virtual environments
.venv
**/.venv/**
venv
**/venv/**
backend/venv
backend/venv/**

# Exclude Node dependencies
node_modules
**/node_modules/**
frontend/node_modules
frontend/node_modules/**

# Exclude Python caches & testing
__pycache__
**/__pycache__/**
*.pyc
.pytest_cache
**/.pytest_cache/**
tests
**/tests/**
.coverage
htmlcov

# Exclude local databases & temporary upload files
*.db
*.sqlite
*.sqlite3
sqlens.db
backend/sqlens.db
backend/test_uploads
backend/test_uploads/**
data/uploads/*
!data/uploads/.gitkeep

# Exclude development logs, PDFs, and IDE files
*.log
*.pdf
backend/*.pdf
.git
.git/**
.vscode
.idea
.DS_Store
Thumbs.db
