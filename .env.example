# SQLens Environment Variables

# Backend Service Configuration
PROJECT_NAME="SQLens AI-Powered Conversational Database Intelligence"
API_V1_STR="/api"

# Database Configuration (PostgreSQL by default, falls back to SQLite if PG connection fails)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sqlens"

# Gemini LLM Provider Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_SECONDS=15
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# Upload & Safeguard Limits
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIRECTORY="./uploads"
QUERY_TIMEOUT_SECONDS=15
MAX_RESULT_ROWS=1000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
